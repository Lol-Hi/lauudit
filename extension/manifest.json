{
  "manifest_version": 3,
  "name": "Lauudit",
  "version": "0.1.0",
  "description": "Audit visible legal-AI responses against a local Singapore case corpus.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "action": {
    "default_title": "Audit legal-AI response",
    "default_popup": "src/popup.html"
  },
  "background": {"service_worker": "src/background.js"},
  "side_panel": {"default_path": "src/sidepanel.html"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}]
}
